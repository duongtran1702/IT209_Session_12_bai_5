# =============================================================================
# KỊCH BẢN GỐC KHI CHƯA KHẮC PHỤC (CHỨA 3 LỖI DẪN ĐẾN ĐỨT GÃY PIPELINE)
# Tệp này được lưu để đối chiếu và phân tích trong troubleshooting.md
# =============================================================================
name: Broken CI/CD Pipeline (Original - 3 Critical Errors)

on:
  push:
    branches: [ "main" ]
  workflow_dispatch:

permissions:
  contents: read
  packages: write

jobs:
  test:
    name: Gradle Test & Build
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      - name: Setup Java JDK 21
        uses: actions/setup-java@v4
        with:
          java-version: '21'
          distribution: 'temurin'

      # [LỖI 1 - Permission Denied]: Thiếu lệnh cấp quyền thực thi "chmod +x gradlew"
      # Khi chạy trên Linux runner, gradlew bị từ chối thực thi:
      # /home/runner/work/_temp/xxx.sh: line 1: ./gradlew: Permission denied
      - name: Run Unit Tests with Gradle
        run: ./gradlew test

  docker-build:
    name: Build & Push Docker Image
    needs: test
    runs-on: ubuntu-latest
    steps:
      - name: Checkout Code
        uses: actions/checkout@v4

      # [LỖI 2 - Authentication Failed]: Sai chính tả tên biến Secret ${{ secrets.REGISTRY_TOKKEN }}
      # Do thừa chữ 'K' hoặc sai tên secret, giá trị trả về rỗng khiến Docker Registry từ chối đăng nhập:
      # Error: Error response from daemon: Get "https://ghcr.io/v2/": unauthorized: authentication required
      - name: Log in to Docker Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.REGISTRY_TOKKEN }}

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v3

      # [LỖI 3 - Build Context Error]: Chỉ định sai context và file Dockerfile
      # Trỏ vào thư mục ./invalid-context/ khiến Docker không tìm thấy Dockerfile:
      # ERROR: failed to solve: failed to read dockerfile: open /var/lib/docker/.../Dockerfile: no such file or directory
      - name: Build and Push Docker Image
        uses: docker/build-push-action@v5
        with:
          context: ./invalid-context/
          file: ./invalid-context/Dockerfile
          push: true
          tags: ghcr.io/${{ github.repository }}:latest
